# ============================================================================
# Guest Reviews Dashboard - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual API keys
# 
# IMPORTANT: At least one AI API key must be configured for the
# AI chat and analysis features to work properly.
# ============================================================================

# Google Gemini API Key
# Get your key at: https://makersuite.google.com/app/apikey
# Model: gemini-2.5-flash or higher
VITE_GEMINI_API_KEY=

# Anthropic Claude API Key
# Get your key at: https://console.anthropic.com/
# Model: claude-sonnet-4-20250514
VITE_ANTHROPIC_API_KEY=

# OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
# Model: gpt-4.1-mini
VITE_OPENAI_API_KEY=

# OpenRouter API Key (Universal LLM Router)
# Get your key at: https://openrouter.ai/keys
# Provides access to multiple models: Claude, GPT-4, Mistral, Llama, etc.
VITE_OPENROUTER_API_KEY=